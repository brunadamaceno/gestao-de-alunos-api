# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.

# String de conexão do MongoDB usada pela API e pelos testes.
MONGODB_URI=mongodb://127.0.0.1:27017/gestao-de-alunos

# Segredo usado para assinar os tokens JWT.
JWT_SECRET=segredo-dev-gestao-de-alunos

# Porta em que o servidor sobe (não é usada pelos testes, que importam o app diretamente).
PORT=3000

# Credenciais do administrador pré-cadastrado pelo seed, usadas pelo helper de login nos testes.
ADMIN_EMAIL=admin@escola.com
ADMIN_SENHA=admin123
